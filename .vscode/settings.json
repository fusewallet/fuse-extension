{
    "typescript.tsdk": "./node_modules/typescript/lib",
    "npm.packageManager": "pnpm",
    "editor.tabSize": 4,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.eol": "\n",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "material-icon-theme.folders.associations": {
        "iconfont": "font",
        "tabs": "public",
        "memo": "functions",
        "local": "base",
        "actions": "queue",
        "ports": "connection",
        "background": "admin",
        "session": "guard",
        "sync": "aws",
        "storage": "store",
    },
    "cSpell.words": [
        "BGSW",
        "choptop",
        "CSUI",
        "CSUIJSX",
        "dfinity",
        "fusewallet",
        "hdkey",
        "heroui",
        "ianvs",
        "iconfont",
        "icrc1",
        "icrc10",
        "icrc2",
        "icrc21",
        "icrc3",
        "inpage",
        "jellypack",
        "jestconfig",
        "keccak",
        "moralis",
        "multicall",
        "nanos",
        "pangea",
        "plasmo",
        "plasmohq",
        "qrcode",
        "secp256k",
        "shadcn",
        "sidepanel",
        "solana",
        "sonner",
        "subaccount",
        "testflight",
        "usehooks",
        "vaul",
        "viem"
    ],
    "nuxt.isNuxtApp": false
}
